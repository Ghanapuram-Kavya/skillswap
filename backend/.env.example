# SkillSwap Environment Configuration
# CognoDB Cloud Connection Details (or any openCypher / Neo4j compatible database)
# Obtain free instance credentials at https://console.cognodb.com

COGNODB_URI=bolt+s://instance-id.databases.cognodb.cloud
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=your-secure-password
PORT=5000
NODE_ENV=development
